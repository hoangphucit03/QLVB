# 2. CƠ SỞ DỮ LIỆU GOOGLE SHEETS
# Spreadsheet ID của file DOCFLOW_DATABASE (chứa sheet VAN_BAN_DEN và VAN_BAN_DI)
DOCFLOW_DATABASE_ID=1LX5rXm81Mnm_sQcjXVzVGLFmD4LICuLCvnbzV3pf-zY

# Spreadsheet ID của file DOCFLOW_SYSTEM (chứa sheet DANH_MUC, THONG_KE, CAU_HINH)
